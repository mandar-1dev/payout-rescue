# Copy to .env for local development. Never commit real secrets.
APP_ENV=development                 # production on Render
PORT=8080
DATABASE_URL=postgres://postgres:pw@localhost:5432/payoutrescue?sslmode=disable
AUTO_MIGRATE=true
ADMIN_TOKEN=dev-token               # required when APP_ENV=production
PUBLIC_BASE_URL=                    # e.g. https://payoutrescue.onrender.com (shown on the Setup page)
PLATFORM_NAME=Acme Creators

# PayPal sandbox only. The server refuses any other base URL.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
WEBHOOK_BYPASS=false                # true skips signature checks (sandbox simulator events only)

FAKE_ENABLED=true                   # in-memory PayPal stand-in (ONHOLD, BLOCKED, day-30 return, late claim)

# Optional language model. Without one, templates and deterministic reply reading are used.
LLM_PROVIDER=none                   # none | anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5

RECONCILE_INTERVAL_SECONDS=300
